import java.util.*;

public class Main {

    public static int[] countingSort(int[] arr) {
        int[] freq = new int[100];

        for (int num : arr) {
            freq[num]++;
        }

        return freq;
    }

    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        int n = sc.nextInt();
        int[] arr = new int[n];

        for (int i = 0; i < n; i++) {
            arr[i] = sc.nextInt();
        }

        int[] result = countingSort(arr);

        for (int i = 0; i < 100; i++) {
            System.out.print(result[i]);
            if (i != 99) {
                System.out.print(" ");
            }
        }
    }
}  
